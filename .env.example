# GrowthPilot AI environment
# Copy this file to .env.local and fill in the values you actually have.
# Never commit .env.local. Never put secret keys in NEXT_PUBLIC_ variables.

# Public app URL used for auth redirects, unsubscribe links, and scheduled jobs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — required for authentication and all workspace data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required to store integration secrets and run scheduled jobs.
SUPABASE_SERVICE_ROLE_KEY=

# Encrypts workspace integration secrets at rest. 32+ character random string.
# Required before a workspace can save its own provider keys.
INTEGRATION_ENCRYPTION_KEY=

# Protects /api/jobs/* and Supabase scheduled functions.
CRON_SECRET=

# AI providers. Server-only. Workspace settings can override these.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Lead discovery. Each integration stays disabled until its credentials exist.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
GOOGLE_MAPS_API_KEY=
HUNTER_API_KEY=
APOLLO_API_KEY=

# Email. Gmail uses OAuth; Resend uses an API key.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=

# Reserved for a future billing release. No Stripe calls are made in this version.
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
